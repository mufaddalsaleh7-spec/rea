# Copy to .env and edit. docker-compose reads this file automatically.

# Where the app listens inside the container (published port is PORT below).
PORT=3000
HOST=0.0.0.0

# Absolute path inside the container. Must sit on the mounted volume.
TALLYCRAFT_DB=/data/tallycraft.db

# Seed the demo company (Surat Weaves Pvt Ltd) when the database is empty.
# Set to 0 for a real book.
TALLYCRAFT_DEMO=1

# The URL people actually open. Used by /api/instance and the install prompt.
# Leave empty to derive it from the request/host.
PUBLIC_URL=http://localhost:3000

# Comma-separated extra ports answering the same app (preview proxies only).
# Leave empty in a normal deployment.
TALLYCRAFT_ALIASES=

# Shown in /api/instance so an operator can tell which build is live.
TALLYCRAFT_RELEASE=dev
