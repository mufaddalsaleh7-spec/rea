{
  "name": "tallycraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A double-entry accounting workspace modelled on Tally Prime: vouchers, ledgers, trial balance, balance sheet, P&L, inventory and Tally XML import/export.",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "tallycraft": "bin/tallycraft.js"
  },
  "scripts": {
    "backup": "node scripts/backup.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build:static": "node scripts/build-static.mjs",
    "check": "node scripts/bootstrap.mjs --check",
    "docker:build": "docker build -t tallycraft:1.0.0 .",
    "docker:logs": "docker compose logs -f --tail 100",
    "docker:up": "docker compose up -d --build",
    "export": "node --disable-warning=ExperimentalWarning bin/tallycraft.js export",
    "health": "node scripts/healthcheck.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "node scripts/serve.mjs --port 3000 --demo",
    "restore": "node scripts/restore.mjs",
    "seed": "node --disable-warning=ExperimentalWarning bin/tallycraft.js seed",
    "snapshot": "node scripts/snapshot.mjs",
    "start": "node scripts/serve.mjs --port 3000 --demo",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "up": "node scripts/bootstrap.mjs --serve"
  },
  "license": "MIT"
}
